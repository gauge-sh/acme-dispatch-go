{{define "title"}}Customers — Acme Dispatch{{end}}
{{define "content"}}
<div class="page-head">
  <h1>Customers</h1>
  <form method="get" action="/customers">
    <input type="search" name="q" value="{{.Data.Query}}" placeholder="Name or address" autofocus>
    <button type="submit" class="subtle">Search</button>
  </form>
  <a class="button" href="/customers/new">New customer</a>
</div>
{{if .Data.Customers}}
<table>
  <tr><th>Name</th><th>Service address</th><th>Contact</th><th>Phone</th></tr>
  {{range .Data.Customers}}
  <tr>
    <td><a href="/customers/{{.ID}}">{{.Name}}</a></td>
    <td>{{.ServiceAddress}}</td>
    <td>{{deref .ContactEmail}}</td>
    <td>{{deref .Phone}}</td>
  </tr>
  {{end}}
</table>
<div class="pager">
  {{with .Data.Pager.PrevURL}}<a href="{{.}}">&larr; Previous</a>{{end}}
  <span>Page {{.Data.Pager.Page}} of {{.Data.Pager.Pages}} · {{.Data.Pager.Total}} customers</span>
  {{with .Data.Pager.NextURL}}<a href="{{.}}">Next &rarr;</a>{{end}}
</div>
{{else if .Data.Query}}
<div class="empty">No customers match “{{.Data.Query}}”.</div>
{{else}}
<div class="empty">No customers yet. <a href="/customers/new">Add the first one.</a></div>
{{end}}
{{end}}
